{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c1c1c3",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#4d447b",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#444474",
    "background_color": "#080812",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#2b2d47"
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#c1c1c3",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#2b2d47",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#2b2d47",
    "underline": true
  },
  "link_text": {
    "color": "#34314b",
    "bold": true
  },
  "image": {
    "color": "#c1c1c3",
    "underline": true
  },
  "image_text": {
    "color": "#57576a",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2b2d47",
    "background_color": "#080812"
  },
  "code_block": {
    "color": "#c1c1c3",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#c1c1c3"
      },
      "error": {
        "color": "#1c2334",
        "background_color": "#080812"
      },
      "comment": {
        "color": "#57576a"
      },
      "comment_preproc": {
        "color": "#24243c"
      },
      "keyword": {
        "color": "#292c3c"
      },
      "keyword_reserved": {
        "color": "#2b2d47"
      },
      "keyword_namespace": {
        "color": "#34314b"
      },
      "keyword_type": {
        "color": "#444474"
      },
      "operator": {
        "color": "#473e6a"
      },
      "punctuation": {
        "color": "#4d447b"
      },
      "name": {
        "color": "#c1c1c3"
      },
      "name_builtin": {
        "color": "#43546a"
      },
      "name_tag": {
        "color": "#445274"
      },
      "name_attribute": {
        "color": "#545481"
      },
      "name_class": {
        "color": "#c1c1c3",
        "underline": true,
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "#24243c"
      },
      "name_exception": {},
      "name_function": {
        "color": "#242433"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#292c3c"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#c1c1c3"
      },
      "literal_string_escape": {
        "color": "#34314b"
      },
      "generic_deleted": {
        "color": "#444474"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#473e6a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#24243c"
      },
      "background": {
        "background_color": "#080812"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
